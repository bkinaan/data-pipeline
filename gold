#!/bin/bash

if [ -z "$1" ]; then
	echo "Missing first argument"
	exit 1
fi

if [ "$1" == "one" ]; then
	if [ -z "$2" ]; then
		uv run -m data_pipeline.gold one
	else
		uv run -m data_pipeline.gold one $2
	fi
elif [ "$1" == "dev" ]; then
	uv run -m data_pipeline.gold dev
elif [ $1 == "eval" ]; then
	uv run -m data_pipeline.gold eval
else
	echo "Unkown option"
fi
